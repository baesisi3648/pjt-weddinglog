# ===== 포트 설정 =====
# 로컬 호스트에서 노출할 포트. 충돌 시 값을 바꾸면 됩니다.
# 예: 기본 3000/8000이 다른 서비스와 충돌하면 3100/8100 등으로 변경.
API_PORT=8000
WEB_PORT=3000

# ===== OpenAI API (선택) =====
# 키가 없으면 사전 정의 템플릿 폴백으로 동작합니다.
# - 체크리스트: 15개 고정 일정 (D-180 ~ D+14)
# - 캡션: 카테고리별 3개 사전 캡션 로테이션
# 심사자는 키 없이도 전체 UX를 확인할 수 있습니다.
OPENAI_API_KEY=

# ===== 데이터베이스 =====
# 컨테이너 내부 경로 기준. ./data 볼륨 마운트로 호스트에 영속.
DATABASE_URL=sqlite:////app/data/weddinglog.db

# ===== CORS =====
# 쉼표로 분리. 기본값은 Vite dev(3000 또는 5173).
# WEB_PORT를 바꾸면 이 값도 같은 포트로 맞춰주세요.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== 로깅 =====
# 값: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
