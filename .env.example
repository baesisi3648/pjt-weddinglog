# ===== 포트 설정 =====
# 로컬 호스트에서 노출할 포트. 충돌 시 값을 바꾸면 됩니다.
API_PORT=8000
WEB_PORT=3000

# ===== OpenAI API (선택) =====
# 키가 없으면 사전 정의 템플릿 폴백으로 동작합니다 (체크리스트 15개, 캡션 3개).
# 키가 있으면 GPT-4o-mini로 실제 생성.
OPENAI_API_KEY=

# ===== 데이터베이스 =====
# 컨테이너 내부 경로 기준. ./data 볼륨 마운트로 호스트에 영속.
DATABASE_URL=sqlite:////app/data/weddinglog.db

# ===== CORS =====
# 쉼표로 분리. 기본값은 Vite dev(3000 또는 5173).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== 로깅 =====
# 값: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
